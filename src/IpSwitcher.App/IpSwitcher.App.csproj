<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for NotifyIcon, the tray icon; WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Off: WPF and WinForms both define Application, Button, MessageBox; usings are explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ip-switcher</AssemblyName>
    <RootNamespace>IpSwitcher</RootNamespace>
    <!-- WPF0001: Application.ThemeMode (the Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IpSwitcher.Core\IpSwitcher.Core.csproj" />
  </ItemGroup>

</Project>
