<Window x:Class="IpSwitcher.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Switcher"
        Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="56" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAdd}" Value="True">
                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="10,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Padding="12,12,12,8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Network adapters" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,10" />

        <Border x:Name="WarningBar" Grid.Row="1" Visibility="Collapsed" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AdapterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10,8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Tooltip}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;"
                                            ToolTip="More" Click="AdapterMenu_Click" />
                                </Grid>

                                <TextBlock Text="{Binding AddressText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ModeText}" Foreground="{Binding ModeBrush}" FontSize="12" Margin="0,1,0,0" />

                                <ItemsControl ItemsSource="{Binding Choices}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChoiceButton}" Content="{Binding Label}"
                                                    ToolTip="{Binding Summary}" Click="Choice_Click" IsEnabled="{Binding IsEnabled}"
                                                    MouseRightButtonUp="Choice_RightClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Message}" Visibility="{Binding MessageVisibility}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,0,0,4" Foreground="{Binding MessageBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed" Margin="4,0,0,12"
                   Text="No physical network adapters with IPv4 found."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DockPanel Grid.Row="3" Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource FooterButton}" Content="Quit" Click="Quit_Click" />
            <Button Style="{StaticResource FooterButton}" Content="Network Connections" HorizontalAlignment="Left"
                    Click="NetworkConnections_Click" />
        </DockPanel>
    </Grid>
    </Border>
</Window>
